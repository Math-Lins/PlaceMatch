# Copie este arquivo para .env e ajuste os valores.
# NUNCA commite o .env de verdade no GitHub — apenas este .env.example.

# Django
SECRET_KEY=gere-uma-chave-segura-aqui
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de dados (PostgreSQL via Docker)
# Para rodar o Django FORA do Docker: DB_HOST=localhost e DB_PORT=5433
# Dentro do Docker o compose sobrescreve para db:5432 automaticamente.
DB_NAME=placematch
DB_USER=placematch_user
DB_PASSWORD=altere_esta_senha
DB_HOST=localhost
DB_PORT=5433
