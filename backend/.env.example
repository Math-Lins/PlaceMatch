# Copie este arquivo para .env (backend/.env). O .env real NÃO é versionado:
# nunca commite segredos, apenas este .env.example.

# ─── Django ───────────────────────────────────────────────────────────────────
# SECRET_KEY: use no MÍNIMO 32 caracteres (ela também assina os tokens JWT, HS256;
# chaves menores geram aviso). Com DEBUG=False a aplicação NÃO sobe se SECRET_KEY
# estiver ausente ou com menos de 32 caracteres. Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-uma-chave-aleatoria-com-no-minimo-32-caracteres
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Banco de dados (PostgreSQL via Docker) ───────────────────────────────────
DB_NAME=placematch
DB_USER=placematch_user
# A senha só é gravada no banco na PRIMEIRA criação do volume do Postgres.
# Se você trocar esta senha depois, veja "password authentication failed" em docs/runbook-docker.md.
DB_PASSWORD=altere_esta_senha
# Para rodar o Django FORA do Docker: DB_HOST=localhost e DB_PORT = porta publicada
# no host (o compose publica ${DB_PORT}:5432; 5433 evita conflito com um Postgres local).
# Dentro do Docker o compose sobrescreve para db:5432 automaticamente.
DB_HOST=localhost
DB_PORT=5433

# ─── Administrador (comando: python manage.py criar_admin) ────────────────────
# Sem ADMIN_SENHA, o comando gera uma senha aleatória e a mostra uma única vez.
ADMIN_EMAIL=admin@placematch.com
# ADMIN_SENHA=defina-uma-senha-forte
