# Copie este arquivo para .env (backend/.env). O .env real NÃO é versionado:
# nunca commite segredos, apenas este .env.example.

# ─── Django ───────────────────────────────────────────────────────────────────
# SECRET_KEY: use no MÍNIMO 32 caracteres (ela também assina os tokens JWT, HS256;
# chaves menores geram aviso). Com DEBUG=False a aplicação NÃO sobe se SECRET_KEY
# estiver ausente ou com menos de 32 caracteres. Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-uma-chave-aleatoria-com-no-minimo-32-caracteres
# DEBUG: sem esta variável o padrão é False (modo seguro, exige SECRET_KEY de 32+ caracteres).
# No desenvolvimento use True, como abaixo. Em produção use False (veja "Implantação em produção" no README).
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Limite de tentativas de login (só contam as que FALHAM; 429 ao passar) ───
# Formato N/min ou N/hour; vazio ou "off" desliga (útil em testes automatizados).
LOGIN_LIMITE_IP=5/min
LOGIN_LIMITE_EMAIL=10/hour
# Quantos proxies confiáveis existem na frente da API (0 = ignora o X-Forwarded-For).
PROXIES_CONFIAVEIS=0

# ─── Recuperação de senha por e-mail ──────────────────────────────────────────
# Endereço do frontend usado no link do e-mail ({FRONTEND_URL}/?screen=redefinir-senha&uid=...&token=...).
FRONTEND_URL=http://localhost:5173
# Pedidos de link: por e-mail e por IP (acima disso a API responde o mesmo 200, sem enviar). Vazio/off desliga.
SENHA_LIMITE_EMAIL=3/15min
SENHA_LIMITE_IP=10/hour
# E-mail em desenvolvimento: sem EMAIL_HOST o e-mail (com o link) é impresso no console do servidor.
# Produção (SMTP): defina TODAS as variáveis abaixo no .env do servidor; nunca versione valores reais.
# EMAIL_HOST=smtp.exemplo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=PlaceMatch <nao-responda@exemplo.com>
# Opcional: força outro backend de e-mail do Django (sem ela, SMTP se houver EMAIL_HOST, senão console).
# O e2e usa o backend de arquivo para ler o link de recuperação:
# EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
# EMAIL_FILE_PATH=caminho/da/pasta/dos/emails

# ─── Afinidade por IA (7º critério do score; modelo de linguagem local) ───────
# Liga/desliga o critério. Desligado (False), o score usa só os 6 critérios (pesos renormalizados).
IA_HABILITADA=True
# Pasta do modelo baixado por "python manage.py baixar_modelo_ia" (~230 MB). Vazio = backend/.modelos (fora do git).
# Depois de baixado, o servidor carrega o modelo só do disco: nenhum texto sai do servidor.
IA_MODELO_DIR=
# IA_EMBEDDER=fastembed   # "falso" só nos testes automatizados (não use em desenvolvimento nem em produção)

# ─── Produção (opcionais; ficam desligados por padrão) ────────────────────────
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_PROXY_SSL_HEADER=True
# CORS_ALLOWED_ORIGINS=https://app.exemplo.com

# ─── Banco de dados (PostgreSQL via Docker) ───────────────────────────────────
DB_NAME=placematch
DB_USER=placematch_user
# A senha só é gravada no banco na PRIMEIRA criação do volume do Postgres.
# Se você trocar esta senha depois, veja "password authentication failed" em docs/runbook-docker.md.
DB_PASSWORD=altere_esta_senha
# Para rodar o Django FORA do Docker: DB_HOST=localhost e DB_PORT = porta publicada
# no host (o compose publica ${DB_PORT}:5432; 5433 evita conflito com um Postgres local).
# Dentro do Docker o compose sobrescreve para db:5432 automaticamente.
DB_HOST=localhost
DB_PORT=5433

# ─── Administrador (comando: python manage.py criar_admin) ────────────────────
# Sem ADMIN_SENHA, o comando gera uma senha aleatória e a mostra uma única vez.
ADMIN_EMAIL=admin@exemplo.com
# ADMIN_SENHA=defina-uma-senha-forte
