# Modelo das variáveis dos testes e2e. Copie para frontend/e2e/.env.e2e (NÃO versionado)
# e troque os valores marcados. Estes dados são só de teste: o banco do e2e é descartável.

# Conta do administrador de TESTE (criada por "criar_admin" no banco do e2e)
E2E_ADMIN_EMAIL=e2e-admin@teste.com
E2E_ADMIN_SENHA=troque-por-uma-senha-forte

# Banco PostgreSQL descartável do e2e (container placematch_e2e_db, porta 5433)
E2E_DB_NAME=pm_e2e
E2E_DB_USER=pm_e2e
E2E_DB_PASSWORD=troque-por-uma-senha-de-banco
E2E_DB_PORT=5433

# Portas dos servidores subidos pelo Playwright
E2E_API_PORT=8001
E2E_WEB_PORT=5173

# Mínimo de 32 caracteres (assina os JWT do backend de teste)
E2E_SECRET_KEY=troque-por-uma-chave-com-no-minimo-32-caracteres

# Opcional: interpretador Python usado para subir o backend (padrão: python)
# E2E_PYTHON=python
