# Copie este arquivo para .env (frontend/.env). O .env real NÃO é versionado.
# Todas as variáveis VITE_* ficam visíveis no navegador: nunca coloque segredos aqui.

# URL base da API Django. Sem a variável, o frontend usa http://127.0.0.1:8000.
# Se a API estiver em outra porta/host, ajuste (o CORS do backend libera apenas
# http://localhost:5173 e http://127.0.0.1:5173 como origem do frontend).
VITE_API_URL=http://localhost:8000

# Só se o hot-reload não funcionar no Docker do Windows (veja docs/runbook-docker.md):
# CHOKIDAR_USEPOLLING=true
