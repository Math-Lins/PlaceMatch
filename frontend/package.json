{
  "name": "placematch-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "test": "node --test tests/*.test.cjs",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:tour": "playwright test -c e2e/playwright.tour.config.ts",
    "e2e:db": "docker compose -f e2e/docker-compose.e2e.yml --env-file e2e/.env.e2e up -d --wait",
    "e2e:db:parar": "docker compose -f e2e/docker-compose.e2e.yml --env-file e2e/.env.e2e down -v"
  },
  "dependencies": {
    "@fontsource/nunito": "5.3.0",
    "@fontsource/outfit": "5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
